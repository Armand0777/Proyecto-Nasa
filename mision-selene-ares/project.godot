; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="mision-selene-ares"
run/main_scene="res://scenes/MenuPrincipal.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

general/text_to_speech=true

[autoload]

Ajustes="*res://scripts/Ajustes.gd"
GameManager="*res://scripts/GameManager.gd"
Sonidos="*res://scripts/Sonidos.gd"
MenuPausa="*res://scripts/MenuPausa.gd"
ControlesTactiles="*res://scripts/ControlesTactiles.gd"
Transicion="*res://scripts/Transicion.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://ui/Tema.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=2048
scaling_3d/scale.web=0.8
scaling_3d/scale.mobile=0.75
lights_and_shadows/directional_shadow/size.mobile=1024
textures/vram_compression/import_etc2_astc=true
